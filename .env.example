# AI Lead Recovery & Sales Automation Platform Configuration
# ==========================================================

# Port for local development (defaults to 3080)
PORT=3080

# Environment mode (development / production)
NODE_ENV=production

# Public Ethereum Receiving Address (Receive-Only, Native ETH on Ethereum Mainnet)
# Default official address: 0x01791e7a273392859e529a69a6b8e6b76e48a3bb
ETH_RECEIVING_ADDRESS=0x01791e7a273392859e529a69a6b8e6b76e48a3bb

# Ethereum Mainnet JSON-RPC Endpoint (Read-Only)
# Options: https://ethereum-rpc.publicnode.com, https://cloudflare-eth.com, or your Infura/Alchemy RPC URL
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Chainlink ETH/USD On-Chain Oracle Address on Ethereum Mainnet
CHAINLINK_ETH_USD_ORACLE=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419

# Optional: Managed Database URL (PostgreSQL / Neon / Supabase) for multi-region serverless persistence
# If unset, the platform uses self-contained in-memory buffer with auto-seeding
DATABASE_URL=

